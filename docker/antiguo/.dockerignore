# =====================================================================
# .dockerignore - Archivos excluidos del contexto de build Docker
# =====================================================================
# Reduce tamaño de contexto y evita copiar secretos/basura

# Git y CI
.git
.gitignore
.github
.gitlab-ci.yml

# Entornos virtuales y cache Python
.venv
venv
__pycache__
*.pyc
*.pyo
.pytest_cache
.coverage
htmlcov
.tox
.mypy_cache
.ruff_cache

# Node.js
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store

# Build outputs
dist
build
*.egg-info

# IDE y OS
.vscode
.idea
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs y datos locales
logs
*.log
.env
.env.local
.env.*.local

# Tests y coverage
tests
.coverage
coverage.xml

# Documentación y assets no necesarios en runtime
docs
promo
ERS.md
PR01-UD1*.pptx
README.md
*.md

# Docker
Dockerfile*
docker-compose*
.dockerignore

# Archivos de configuración local
vite.config.ts.timestamp-*
*.local.ts