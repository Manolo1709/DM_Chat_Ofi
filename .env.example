# Copiar a .env (nunca se sube al repositorio)

# Proveedor de IA con API compatible con OpenAI. Por defecto, OpenRouter:
#   clave en https://openrouter.ai/keys
#   modelos en https://openrouter.ai/models (los que acaban en :free son gratis)
# Para OpenCode Zen: LLM_BASE_URL=https://opencode.ai/zen/v1 y su clave
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=poolside/laguna-s-2.1:free

# Frontend: true para usar la respuesta de ejemplo sin backend
VITE_USE_MOCK=false
