# =====================================================================
# .env.example - Copia a .env y rellena tus valores
# NUNCA commitees .env real con claves secretas
# =====================================================================

# --- IA (Groq, API compatible con OpenAI) ---
# Obtén tu clave en https://console.groq.com/keys
LLM_API_KEY=gsk_tu-clave-aqui
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b

# --- App ---
APP_ENV=development
LOG_ARCHIVO=true
LOG_LEVEL=DEBUG

# --- Frontend (Vite) ---
# VITE_USE_MOCK=true  # Descomenta para desarrollar sin backend
# --- Clerk (valores ficticios; los reales no se suben a Git) ---
CLERK_SECRET_KEY=sk_test_tu-clave-secreta
VITE_CLERK_PUBLISHABLE_KEY=pk_test_tu-clave-publicable

# --- Docker Compose ---
# Origen desde el que se abre la web (en EC2, la URL pública con https)
FRONTEND_ORIGIN=http://localhost:8080
# PUERTO_WEB=8080

# Modelos con razonamiento (Gemini 2.5): none evita respuestas cortadas
# LLM_REASONING_EFFORT=none
